#include <windows.h>
#include "resource.h"

// Pull baseline fallback application logo asset frame
IDI_APP_ICON ICON DISCARDABLE 
BEGIN
    0x0000, 0x0000, 0x0000, 0x0000
END

// Main Dropdown Menu Configuration
IDR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                       ID_FILE_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Full Screen\tEsc",           ID_VIEW_FULLSCREEN
    END
END

// ============================================================================
// SYSTEM EMBEDDED FILE INFORMATION BLOCK
// ============================================================================
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            // 👇 CHANGE YOUR COMPANY METADATA HERE 👇
            VALUE "CompanyName",     "Your Company Name Ltd.\0"
            VALUE "FileDescription", "Lightweight KVM Video Capture Engine\0"
            VALUE "FileVersion",     "1.0.0.1\0"
            VALUE "InternalName",    "amcap\0"
            VALUE "LegalCopyright",  "Copyright (C) 2026 Your Company Name. All rights reserved.\0"
            VALUE "OriginalFilename","amcap.exe\0"
            VALUE "ProductName",     "DIY KVM Crash-Cart System\0"
            VALUE "ProductVersion",  "1.0.0.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END